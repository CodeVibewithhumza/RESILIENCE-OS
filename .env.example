# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Graph & Simulation Settings
SIMULATION_TICK_RATE_MS=1000
DEFAULT_SCENARIO=baseline_hospital
MAX_CASCADE_DEPTH=5

# Database Configuration
# The primary database URL used by the application
DATABASE_URL=postgresql+asyncpg://resilience:your_secure_password_here@localhost:5432/resilienceos

# Docker PostgreSQL Configuration
# Used by docker-compose.yml to initialize the local database container
POSTGRES_USER=resilience
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=resilienceos

# Optional Graph Connectors (Default: In-Memory NetworkX)
GRAPH_BACKEND=networkx
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
