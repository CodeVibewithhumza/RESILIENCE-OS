# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Graph & Simulation Settings
SIMULATION_TICK_RATE_MS=1000
DEFAULT_SCENARIO=baseline_hospital
MAX_CASCADE_DEPTH=5

# Optional Database & Graph Connectors (Default: In-Memory NetworkX)
GRAPH_BACKEND=networkx
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://resilience_user:YOUR_PASSWORD@localhost:5432/resilience_os
